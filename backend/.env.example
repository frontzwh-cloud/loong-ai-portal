# Local demo makes no external AI requests. Set false to enable a real approved service.
PORTAL_DEMO_MODE=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set the exact model ID provided by your approved provider; no model availability is assumed.
DEEPSEEK_MODEL=
# Browser-visible navigation links only. HTTP(S), no credentials or secret tokens.
GEMBA_URL=
MEETING_DOWNLOAD_URL=
KNOWLEDGE_URL=
WORKFLOW_URL=
PDF_TOOL_URL=
OFFICE_TOOLS_URL=
# Local launcher: loopback only; change port if 8000 is occupied.
PORTAL_PORT=8000

# Enterprise CAS + Workflow login (off until integration values are configured)
SSO_ENABLED=false
PORTAL_PUBLIC_URL=https://portal.example.internal
CAS_BASE_URL=http://W3UY084VMA:9099
# Workflow employee master: SQL Server username/password, read-only account.
WORKFLOW_DB_HOST=
WORKFLOW_DB_PORT=1433
WORKFLOW_DB_NAME=
WORKFLOW_DB_USER=
WORKFLOW_DB_PASSWORD=
# Optional trusted CA bundle for TLS verification; coordinate with DBA.
WORKFLOW_DB_CA_FILE=
# Parameterized SELECT; must return columns aliased uid, name, department, active.
# Table/column names are NOT yet known. Configure against the real Workflow schema.
# Example only: SELECT UID AS uid, FullName AS name, Department AS department, IsActive AS active FROM dbo.Employee WHERE UID = %s
WORKFLOW_USER_SQL=
# Registered application id -> exact HTTPS callback and >=32-char secret. Server-only.
SSO_APPS_JSON={}
# Only for local loopback development; never enable in production.
SSO_ALLOW_INSECURE_LOCAL=false
