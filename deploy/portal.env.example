# Server-local AI configuration. Leave demo=true until an approved service is configured.
# Values are literal: do not add shell quotes; $ characters are not expanded.
PORTAL_DEMO_MODE=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
# false disables certificate verification only for vio.automotive-wan.com.
DEEPSEEK_VERIFY_SSL=true
# Admin UI runs on a separate SSH-forwarded loopback-only port; no password.
# Public navigation URLs only, never credentials or secret tokens.
GEMBA_URL=
MEETING_DOWNLOAD_URL=
KNOWLEDGE_URL=
WORKFLOW_URL=
PDF_TOOL_URL=
OFFICE_TOOLS_URL=
